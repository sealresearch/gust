{
  "name": "gust-workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "gust-workspace",
      "workspaces": [
        "packages/js",
        "packages/relay"
      ]
    },
    "node_modules/@sealresearch/gust": {
      "resolved": "packages/js",
      "link": true
    },
    "node_modules/@sealresearch/relay": {
      "resolved": "packages/relay",
      "link": true
    },
    "packages/js": {
      "name": "@sealresearch/gust",
      "version": "0.2.0",
      "license": "MIT",
      "engines": {
        "node": ">=20"
      }
    },
    "packages/relay": {
      "name": "@sealresearch/relay",
      "version": "0.2.0",
      "license": "MIT",
      "dependencies": {
        "@sealresearch/gust": "^0.1.0 || ^0.2.0"
      },
      "engines": {
        "node": ">=20"
      }
    }
  }
}
