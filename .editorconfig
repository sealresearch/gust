# Editor defaults. Formatting itself is done by tools/format.mjs (clang-format, Prettier, ruff).
# Files pinned by model packages (js/, examples/, models/*/wrapper/, models/*/package/) must keep their exact bytes:
# do not let an editor reformat them on save.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
max_line_length = 120
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,cpp,hpp,py}]
indent_size = 4

[*.ps1]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{js/**,examples/**,models/*/wrapper/**,models/*/package/**,models/forma/**,models/loom/**}]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
